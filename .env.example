# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
READINESS_CACHE_TTL_MS=60000
DB_RUN_MIGRATIONS_ON_STARTUP=true

# MongoDB
# Transactions require a replica set (MongoDB Atlas already provides one).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=turf_gds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

# Prometheus metrics. Default-closed: without METRICS_AUTH_TOKEN only the
# addresses in METRICS_ALLOWED_IPS may scrape, so an unconfigured deployment
# refuses remote scrapes. Exact addresses, not CIDR -- use the token for
# anything beyond a loopback or sidecar scrape.
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_ALLOWED_IPS=127.0.0.1,::1
# METRICS_AUTH_TOKEN=

# Proxy trust. false (default) means request.ip is the socket peer, so
# X-Forwarded-For cannot be spoofed. MUST be set before deploying behind a load
# balancer, or every client looks like the balancer and the IP rate limiter
# becomes one global bucket. Prefer a CIDR list over `true`: with `true` any
# client can forge X-Forwarded-For and evade -- or poison -- the limiter.
# TRUST_PROXY=10.0.0.0/8
TRUST_PROXY=false

# Pre-authentication IP rate limiting. Applies to every route, tiered.
IP_RATE_LIMIT_ENABLED=true
# Deny when both Redis and MongoDB are unavailable. Default false (fail open):
# if MongoDB is down every business route is already failing, and refusing
# traffic on top of that turns a degraded dependency into a total outage.
IP_RATE_LIMIT_FAIL_CLOSED=false
IP_RATE_LIMIT_AUTH_BURST=10
IP_RATE_LIMIT_AUTH_SUSTAINED=60
# Must stay ABOVE the highest Partner tier (ENTERPRISE = 1000/min) or this,
# rather than the contractual per-Partner limit, becomes the binding
# constraint -- with TRUST_PROXY off all of a Partner's traffic shares one IP.
IP_RATE_LIMIT_SIGNED=2000
IP_RATE_LIMIT_GLOBAL=600
# HMAC key for address pseudonymisation. Strongly recommended in production:
# without it a bare SHA-256 of an IPv4 is brute-forceable.
# IP_HASH_SECRET=

# Optional distributed Partner rate limiter. MongoDB is the fallback.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=turf-gds

# Owner dashboard authentication
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_SESSIONS=5
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Platform User HS256 JWT signing key (rotate through deployment secrets).
ADMIN_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_ACCESS_TOKEN_TTL_MINUTES=60
PARTNER_CREDENTIAL_MASTER_SECRET=replace-with-at-least-32-random-characters
PARTNER_HMAC_MAX_SKEW_SECONDS=300
KYC_MAX_FILE_BYTES=10485760
KYC_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# One-time admin bootstrap inputs for: npm run admin:create
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin
# BOOTSTRAP_ADMIN_ROLE=ADMIN

# Cloudinary server credentials
# Find these in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=turf-gds/development

# Background worker (npm run worker:start).
# Runs the outbox drain, expired-hold recovery and payout reconciliation.
# Run exactly one steady-state; jobs lease their work so overlapping deploys
# are safe. Optional: WORKER_ID (defaults to hostname:pid) and WORKER_JOBS
# (comma list to run a subset; empty runs all).
# WORKER_ID=
# WORKER_JOBS=communications-outbox,booking-hold-recovery,treasury-payout-reconciliation

COMMUNICATIONS_POLL_INTERVAL_MS=1000
COMMUNICATIONS_BATCH_SIZE=20
COMMUNICATIONS_LEASE_SECONDS=60
COMMUNICATIONS_REQUEST_TIMEOUT_MS=10000
COMMUNICATIONS_MAX_WEBHOOK_ATTEMPTS=8
COMMUNICATIONS_RETRY_BASE_SECONDS=30
COMMUNICATIONS_RETRY_MAX_SECONDS=3600

# Optional Firebase Cloud Messaging. Durable Owner inbox delivery works when false.
FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# Use escaped newlines when stored on one line.
# FCM_PRIVATE_KEY=

# Admin inventory-health stale coverage threshold
ADMIN_INVENTORY_MIN_COVERAGE_DAYS=7
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_BASE_URL=https://api.razorpay.com
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_BASE_URL=https://api.msg91.com
