# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
READINESS_CACHE_TTL_MS=60000

# MongoDB
# Transactions require a replica set (MongoDB Atlas already provides one).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=turf_gds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

# Owner dashboard authentication
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_SESSIONS=5
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Cloudinary server credentials
# Find these in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=turf-gds/development
