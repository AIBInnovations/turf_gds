# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
READINESS_CACHE_TTL_MS=60000
DB_RUN_MIGRATIONS_ON_STARTUP=true

# MongoDB
# Transactions require a replica set (MongoDB Atlas already provides one).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=turf_gds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

# Optional distributed Partner rate limiter. MongoDB is the fallback.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=turf-gds

# Owner dashboard authentication
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_SESSIONS=5
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Platform User HS256 JWT signing key (rotate through deployment secrets).
ADMIN_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_ACCESS_TOKEN_TTL_MINUTES=60
PARTNER_CREDENTIAL_MASTER_SECRET=replace-with-at-least-32-random-characters
PARTNER_HMAC_MAX_SKEW_SECONDS=300
KYC_MAX_FILE_BYTES=10485760
KYC_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# One-time admin bootstrap inputs for: npm run admin:create
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin
# BOOTSTRAP_ADMIN_ROLE=ADMIN

# Cloudinary server credentials
# Find these in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=turf-gds/development

# Dedicated Communications worker
COMMUNICATIONS_POLL_INTERVAL_MS=1000
COMMUNICATIONS_BATCH_SIZE=20
COMMUNICATIONS_LEASE_SECONDS=60
COMMUNICATIONS_REQUEST_TIMEOUT_MS=10000
COMMUNICATIONS_MAX_WEBHOOK_ATTEMPTS=8
COMMUNICATIONS_RETRY_BASE_SECONDS=30
COMMUNICATIONS_RETRY_MAX_SECONDS=3600

# Optional Firebase Cloud Messaging. Durable Owner inbox delivery works when false.
FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# Use escaped newlines when stored on one line.
# FCM_PRIVATE_KEY=

# Admin inventory-health stale coverage threshold
ADMIN_INVENTORY_MIN_COVERAGE_DAYS=7
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_BASE_URL=https://api.razorpay.com
