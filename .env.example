# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
READINESS_CACHE_TTL_MS=60000

# MongoDB
# Transactions require a replica set (MongoDB Atlas already provides one).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=turf_gds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

# Owner dashboard authentication
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_SESSIONS=5
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
ADMIN_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_ACCESS_TOKEN_TTL_MINUTES=60
PARTNER_CREDENTIAL_MASTER_SECRET=replace-with-at-least-32-random-characters
PARTNER_HMAC_MAX_SKEW_SECONDS=300
KYC_MAX_FILE_BYTES=10485760
KYC_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# One-time admin bootstrap inputs for: npm run admin:create
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin
# BOOTSTRAP_ADMIN_ROLE=ADMIN

# Cloudinary server credentials
# Find these in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=turf-gds/development
